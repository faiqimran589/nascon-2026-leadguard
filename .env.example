# Copy this file to .env and fill in real values. NEVER commit .env (it is in .gitignore).
# Integration keys (Twilio, Stripe, Google, Telegram) are NOT put here: each workspace enters its own
# on the Integrations page, where they are stored encrypted in the database.

# --- Required ---
# Neon: console.neon.tech -> your project -> Connect -> copy the connection string
# (remove "&channel_binding=require" from the end if present)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Secret used to encrypt integration credentials. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use the SAME value locally and on Render. Changing it later means reconnecting integrations.
ENCRYPTION_KEY=

# --- Optional ---
PORT=3000
# Public URL of the app. Leave empty locally; Render provides RENDER_EXTERNAL_URL automatically.
# Set it to your tunnel URL (e.g. https://xyz.trycloudflare.com) only when testing webhooks locally.
APP_URL=
# How often the background worker checks deadlines (milliseconds)
WORKER_INTERVAL_MS=2000
# Session lifetime
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
# Demo seed login (npm run seed)
SEED_EMAIL=owner@sunrise.demo
SEED_PASSWORD=Demo@12345
